# Copy to .env and replace placeholder values. Never commit .env.

# Used by docker-compose.yml
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
POSTGRES_DB=financial_data
POSTGRES_PORT=5435

# Used by the Python package (must match the values above)
DATABASE_URL=postgresql://pipeline:change_me@localhost:5435/financial_data

# FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key
